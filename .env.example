# -------------------------------------------------------------
# श्रमेव (Shramev) Rural Agricultural Platform Environment Configuration
# -------------------------------------------------------------

# GEMINI_API_KEY: Required for Gemini AI Multi-Lingual Rural Voice Intake.
# In Google AI Studio / Cloud Run, configure via Secret Manager or runtime secrets.
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# APP_URL: The public hosting URL of the application.
APP_URL="http://localhost:3000"

# Optional: Google Maps Platform JavaScript API Key (with 3D / WebGL enabled)
# If omitted, Shramev provides an ultra-fast hardware-accelerated 3D Canvas engine automatically.
VITE_GOOGLE_MAPS_API_KEY=

# Firebase Client Configuration (Populated automatically or via firebase-applet-config.json)
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKey"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:abcdef123456"

